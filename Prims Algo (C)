#include <stdio.h>

#define MAX 10
#define INF 9999

int main()
{
    int graph[MAX][MAX], visited[MAX] = {0};
    int n, i, j, edges = 0, minCost = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);
            if(graph[i][j] == 0 && i != j)
                graph[i][j] = INF;
        }
    }

    visited[0] = 1;

    printf("\nEdges in Minimum Spanning Tree:\n");

    while(edges < n - 1)
    {
        int min = INF, u = -1, v = -1;

        for(i = 0; i < n; i++)
        {
            if(visited[i])
            {
                for(j = 0; j < n; j++)
                {
                    if(!visited[j] && graph[i][j] < min)
                    {
                        min = graph[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        printf("%d - %d : %d\n", u, v, min);
        visited[v] = 1;
        minCost += min;
        edges++;
    }

    printf("\nMinimum Cost = %d\n", minCost);

    return 0;
}

#include <stdio.h>

int board[4][4];

int isSafe(int row, int col)
{
    int i, j;

    for(i = 0; i < col; i++)
        if(board[row][i])
            return 0;

    for(i = row, j = col; i >= 0 && j >= 0; i--, j--)
        if(board[i][j])
            return 0;

    for(i = row, j = col; i < 4 && j >= 0; i++, j--)
        if(board[i][j])
            return 0;

    return 1;
}

int solve(int col)
{
    int i;

    if(col >= 4)
        return 1;

    for(i = 0; i < 4; i++)
    {
        if(isSafe(i, col))
        {
            board[i][col] = 1;

            if(solve(col + 1))
                return 1;

            board[i][col] = 0;
        }
    }

    return 0;
}

int main()
{
    int i, j;

    if(solve(0))
    {
        printf("Solution:\n");
        for(i = 0; i < 4; i++)
        {
            for(j = 0; j < 4; j++)
            {
                printf("%d ", board[i][j]);
            }
            printf("\n");
        }
    }
    else
    {
        printf("No Solution Exists");
    }

    return 0;
}

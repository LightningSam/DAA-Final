#include <stdio.h>

#define MAX 10
#define INF 9999

int main()
{
    int graph[MAX][MAX], dist[MAX];
    int n, i, j, k, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);

            if(graph[i][j] == 0 && i != j)
                graph[i][j] = INF;
        }
    }

    printf("Enter source vertex: ");
    scanf("%d", &start);

    for(i = 0; i < n; i++)
        dist[i] = INF;

    dist[start] = 0;

    for(k = 1; k <= n - 1; k++)
    {
        for(i = 0; i < n; i++)
        {
            for(j = 0; j < n; j++)
            {
                if(graph[i][j] != INF && dist[i] != INF && dist[i] + graph[i][j] < dist[j])
                {
                    dist[j] = dist[i] + graph[i][j];
                }
            }
        }
    }

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            if(graph[i][j] != INF && dist[i] != INF && dist[i] + graph[i][j] < dist[j])
            {
                printf("Negative weight cycle detected.\n");
                return 0;
            }
        }
    }

    printf("\nShortest distances from vertex %d:\n", start);

    for(i = 0; i < n; i++)
    {
        printf("%d -> %d = %d\n", start, i, dist[i]);
    }

    return 0;
}

#include <stdio.h>

#define INF 999

int main() {
    int gr[100][100], n, i, j, k;

    printf("Enter the number of vertices: ");
    scanf("%d", &n);

    printf("Enter the adjacency matrix:\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &gr[i][j]);
        }
    }

    for (k = 0; k < n; k++) {
        for (i = 0; i < n; i++) {
            for (j = 0; j < n; j++) {
                if (gr[i][k] != INF && gr[k][j] != INF &&
                    gr[i][k] + gr[k][j] < gr[i][j]) {
                    gr[i][j] = gr[i][k] + gr[k][j];
                }
            }
        }
    }

    printf("\nShortest Path Matrix:\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (gr[i][j] == INF)
                printf("INF ");
            else
                printf("%4d", gr[i][j]);
        }
        printf("\n");
    }

    return 0;
}

#include <stdio.h>

#define MAX 10

struct Edge
{
    int u, v, w;
};

struct Edge edge[MAX * MAX];

int parent[MAX];

int find(int i)
{
    while(parent[i] != i)
        i = parent[i];
    return i;
}

void unite(int a, int b)
{
    parent[a] = b;
}

int main()
{
    int n, i, j, e = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    int graph[MAX][MAX];

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);

            if(graph[i][j] != 0 && i < j)
            {
                edge[e].u = i;
                edge[e].v = j;
                edge[e].w = graph[i][j];
                e++;
            }
        }
    }

    for(i = 0; i < e - 1; i++)
    {
        for(j = 0; j < e - i - 1; j++)
        {
            if(edge[j].w > edge[j + 1].w)
            {
                struct Edge temp = edge[j];
                edge[j] = edge[j + 1];
                edge[j + 1] = temp;
            }
        }
    }

    for(i = 0; i < n; i++)
        parent[i] = i;

    int count = 0, cost = 0;

    printf("\nEdges in Minimum Spanning Tree:\n");

    for(i = 0; i < e && count < n - 1; i++)
    {
        int u = find(edge[i].u);
        int v = find(edge[i].v);

        if(u != v)
        {
            printf("%d - %d : %d\n", edge[i].u, edge[i].v, edge[i].w);
            cost += edge[i].w;
            unite(u, v);
            count++;
        }
    }

    printf("\nMinimum Cost = %d\n", cost);

    return 0;
}

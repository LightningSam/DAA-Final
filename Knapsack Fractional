#include <stdio.h>

void swap(float *a, float *b) {
    float temp;
    temp = *a;
    *a = *b;
    *b = temp;
}

void bubbleSort(int n, float p[], float w[], float ratio[]) {
    int i, j;
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (ratio[j] < ratio[j + 1]) {
                swap(&ratio[j], &ratio[j + 1]);
                swap(&p[j], &p[j + 1]);
                swap(&w[j], &w[j + 1]);
            }
        }
    }
}

int main() {
    int n, i;
    float p[20], w[20], ratio[20];
    float x[20], capacity, maxProfit = 0;

    printf("Enter the no. of items: ");
    scanf("%d", &n);

    printf("Enter knapsack capacity: ");
    scanf("%f", &capacity);

    for (i = 0; i < n; i++) {
        printf("\nEnter profit and weight of item %d: ", i + 1);
        scanf("%f %f", &p[i], &w[i]);
        ratio[i] = p[i] / w[i];
    }

    printf("\nOriginal Table\n");
    printf("-------------------------------------\n");
    printf("Item\tProfit\tWeight\tRatio\n");
    printf("-------------------------------------\n");
    for (i = 0; i < n; i++) {
        printf("%d\t%.0f\t%.0f\t%.2f\n", i + 1, p[i], w[i], ratio[i]);
    }
    printf("-------------------------------------\n");

    bubbleSort(n, p, w, ratio);

    printf("\nSorted Table\n");
    printf("-------------------------------------\n");
    printf("Item\tProfit\tWeight\tRatio\n");
    printf("-------------------------------------\n");
    for (i = 0; i < n; i++) {
        printf("%d\t%.0f\t%.0f\t%.2f\n", i + 1, p[i], w[i], ratio[i]);
    }
    printf("-------------------------------------\n");

    for (i = 0; i < n; i++) {
        x[i] = 0.0;
    }

    for (i = 0; i < n; i++) {
        if (w[i] <= capacity) {
            x[i] = 1.0;
            maxProfit += p[i];
            capacity -= w[i];
        } else {
            x[i] = capacity / w[i];
            maxProfit += p[i] * x[i];
            break;
        }
    }

    printf("\nSolution Vector:\n");
    for (i = 0; i < n; i++) {
        if (i < (n - 1))
            printf("%.1f, ", x[i]);
        else
            printf("%.1f", x[i]);
    }

    printf("\n\nMaximum Profit: %.2f\n", maxProfit);
    return 0;
}
